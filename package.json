{
  "name": "college-zone",
  "version": "1.0.0",
  "description": "College Zone roommate-matching app",
  "scripts": {
    "install-all": "npm install && npm install --prefix client && npm install --prefix server",
    "client": "npm start --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "lint": "echo 'No global lint script configured'",
    "test": "npm run test --prefix server && cross-env CI=true npm test --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
